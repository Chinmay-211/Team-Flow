{
  "family": "teamflow-worker-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::123456789012:role/TeamFlowEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/TeamFlowWorkerTaskRole",
  "containerDefinitions": [
    {
      "name": "teamflow-worker",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/teamflow-worker:latest",
      "essential": true,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_SQS_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/123456789012/teamflow-notifications" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/teamflow-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
