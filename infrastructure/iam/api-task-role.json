{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3AttachmentAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::teamflow-attachments-bucket/*"
    },
    {
      "Sid": "SnsPublishAccess",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:123456789012:teamflow-events"
    }
  ]
}
