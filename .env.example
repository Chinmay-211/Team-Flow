# ==========================================
# TeamFlow - Environment Configuration
# ==========================================

NODE_ENV=development
PORT=3000
WORKER_PORT=3001
FRONTEND_PORT=5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamflow?schema=public"

# JWT Authentication
JWT_SECRET="teamflow_super_secret_jwt_key_interview_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# AWS Configuration (Local fallback enabled if blank/invalid)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="teamflow-attachments-bucket"

# AWS SNS & SQS Configuration
AWS_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:teamflow-events"
AWS_SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/teamflow-notifications"

# Amazon OpenSearch Configuration
OPENSEARCH_ENDPOINT="https://search-teamflow-opensearch.us-east-1.es.amazonaws.com"
